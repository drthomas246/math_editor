{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react"],
  "options": {
    "typeAware": true,
    "denyWarnings": true
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "error"
  }
}
